// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Definimos que vamos usar PostgreSQL
  url      = env("DATABASE_URL") // Pega a URL de conexão do arquivo .env
}

// Nosso modelo de dados para a tabela de Projetos
model Project {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @db.Text
  imageUrl    String?  
  repoUrl     String?
  deployInput String?
  technologies String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User{
  id Int @id @default(autoincrement())
  email String @unique
  password String
  role String @default("user") // "user" ou "admin"
  createdAt DateTime @default(now())
}